# Only needed for `ratecon record`, which refreshes the offline response cache.
# `ratecon demo`, `ratecon extract --offline` and the test suite all run without it.
#
#   OPENROUTER_API_KEY=... uv run ratecon record --force --also evals/provided
#
# `--force` matters: the client checks the cache before the network, so without
# it every document hits and the command does nothing.
OPENROUTER_API_KEY=
